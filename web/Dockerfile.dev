FROM node:20-alpine

# Bring in the bun binary (oven/bun images don't ship node, and `dev` runs
# vite, whose bin has a `#!/usr/bin/env node` shebang)
COPY --from=oven/bun:1.3-alpine /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

# Install dependencies
COPY package.json bun.lock ./
RUN bun install

# Copy source code
COPY . .

EXPOSE 3000

CMD ["bun", "run", "dev", "--", "--host"]
